-- ============ CREATOR MODE ============
local CreatorMode = {}

function CreatorMode.Activate(player, mode)
    if not isAdmin(player) then return end
    local data = getPlayerData(player)
    local char = getCharacter(player)
    if not char then return end
    
    if mode == "Creator" then
        data.creatorMode = true
        local aura = Instance.new("Part")
        aura.Size = Vector3.new(20, 20, 20)
        aura.Shape = Enum.PartType.Ball
        aura.Material = Enum.Material.Neon
        aura.Color = Color3.fromRGB(255, 200, 50)
        aura.Transparency = 0.5
        aura.Anchored = true
        aura.CanCollide = false
        aura.Parent = char
        
        local beam = Instance.new("Part")
        beam.Size = Vector3.new(10, 200, 10)
        beam.Material = Enum.Material.Neon
        beam.Color = Color3.fromRGB(255, 200, 50)
        beam.Transparency = 0.5
        beam.Anchored = true
        beam.CanCollide = false
        if char:FindFirstChild("HumanoidRootPart") then
            beam.Position = char.HumanoidRootPart.Position + Vector3.new(0, 100, 0)
        end
        beam.Parent = workspace
        
        Lighting.Ambient = Color3.fromRGB(20, 20, 30)
        Lighting.OutdoorAmbient = Color3.fromRGB(20, 20, 30)
        
        GlobalEvents.SendAnnouncement("THE CREATOR HAS AWAKENED.")
        remoteEvents.TriggerCreatorMode:FireAllClients(player, "Creator")
        
        Debris:AddItem(aura, 60)
        Debris:AddItem(beam, 60)
        
    elseif mode == "FinalCreator" then
        data.finalCreator = true
        data.creatorMode = true
        Lighting.Ambient = Color3.fromRGB(10, 10, 20)
        Lighting.OutdoorAmbient = Color3.fromRGB(10, 10, 20)
        Lighting.Brightness = 0.2
        
        local aura = Instance.new("Part")
        aura.Size = Vector3.new(30, 30, 30)
        aura.Shape = Enum.PartType.Ball
        aura.Material = Enum.Material.Neon
        aura.Color = Color3.fromRGB(255, 255, 255)
        aura.Transparency = 0.3
        aura.Anchored = true
        aura.CanCollide = false
        aura.Parent = char
        
        GlobalEvents.SendAnnouncement("THE FINAL CREATOR FORM HAS AWAKENED.")
        remoteEvents.TriggerCreatorMode:FireAllClients(player, "FinalCreator")
        Debris:AddItem(aura, 120)
    end
end

