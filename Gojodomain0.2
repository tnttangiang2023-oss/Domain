-- Đặt đoạn mã này vào ServerScriptService (Script dạng Server)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

-- Admin Configuration
local ADMIN_CONFIG = {
    AdminIds = {
        [123456789] = true, -- Thay thế bằng UserId của bạn
    },
    AdminNames = {
        ["YourUsername"] = true, -- Thay thế bằng Tên tài khoản Roblox của bạn
    }
}

-- Remote Events Folder
local remoteEvents = ReplicatedStorage:FindFirstChild("AdminRemotes")
if not remoteEvents then
    remoteEvents = Instance.new("Folder")
    remoteEvents.Name = "AdminRemotes"
    remoteEvents.Parent = ReplicatedStorage
end

local function createRemote(name)
    local remote = remoteEvents:FindFirstChild(name)
    if not remote then
        remote = Instance.new("RemoteEvent")
        remote.Name = name
        remote.Parent = remoteEvents
    end
    return remote
end

-- Tạo danh sách các Remote Events
local remotes = {
    "ToggleFly", "ToggleNoClip", "SetSpeed", "SetJumpPower",
    "Teleport", "ResetCharacter", "Heal", "ToggleGodMode",
    "ToggleInvisible", "ToggleKillAura", "SetAuraRange",
    "TriggerCombat", "TriggerGlobalEvent", "TriggerShader",
    "TriggerReality", "TriggerZAKO", "TriggerCreatorMode",
    "SendAnnouncement", "TriggerUltimateEvent"
}

for _, remoteName in pairs(remotes) do
    createRemote(remoteName)
end

-- ============ ADMIN AUTHENTICATION ============
local function isAdmin(player)
    return ADMIN_CONFIG.AdminIds[player.UserId] or ADMIN_CONFIG.AdminNames[player.Name]
end

-- ============ PLAYER DATA STORAGE ============
local playerData = {}

local function getPlayerData(player)
    if not playerData[player] then
        playerData[player] = {
            flyEnabled = false,
            noclipEnabled = false,
            godMode = false,
            invisible = false,
            killAura = false,
            auraRange = 20,
            creatorMode = false,
            finalCreator = false
        }
    end
    return playerData[player]
end

-- ============ CHARACTER HANDLING ============
local function getCharacter(player)
    if player and player.Character then
        return player.Character
    end
    return nil
end

local function getHumanoid(player)
    local char = getCharacter(player)
    if char then
        return char:FindFirstChild("Humanoid")
    end
    return nil
end

local function getRootPart(player)
    local char = getCharacter(player)
    if char then
        return char:FindFirstChild("HumanoidRootPart")
    end
    return nil
end

-- ============ ADMIN COMMANDS ============
local AdminCommands = {}

function AdminCommands.ToggleFly(player)
    if not isAdmin(player) then return end
    local data = getPlayerData(player)
    data.flyEnabled = not data.flyEnabled
    local char = getCharacter(player)
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.PlatformStand = data.flyEnabled
        end
    end
    return data.flyEnabled
end

function AdminCommands.ToggleNoClip(player)
    if not isAdmin(player) then return end
    local data = getPlayerData(player)
    data.noclipEnabled = not data.noclipEnabled
    return data.noclipEnabled
end

function AdminCommands.SetSpeed(player, speed)
    if not isAdmin(player) then return end
    local humanoid = getHumanoid(player)
    if humanoid then
        humanoid.WalkSpeed = speed
        return true
    end
    return false
end

function AdminCommands.SetJumpPower(player, power)
    if not isAdmin(player) then return end
    local humanoid = getHumanoid(player)
    if humanoid then
        humanoid.JumpPower = power
        return true
    end
    return false
end

function AdminCommands.Teleport(player, target)
    if not isAdmin(player) then return end
    local root = getRootPart(player)
    local targetRoot = getRootPart(target)
    if root and targetRoot then
        root.CFrame = targetRoot.CFrame + Vector3.new(0, 3, 0)
        return true
    end
    return false
end

function AdminCommands.ResetCharacter(player)
    if not isAdmin(player) then return end
    player:LoadCharacter()
    return true
end

function AdminCommands.Heal(player)
    if not isAdmin(player) then return end
    local humanoid = getHumanoid(player)
    if humanoid then
        humanoid.Health = humanoid.MaxHealth
        return true
    end
    return false
end

function AdminCommands.ToggleGodMode(player)
    if not isAdmin(player) then return end
    local data = getPlayerData(player)
    data.godMode = not data.godMode
    return data.godMode
end

function AdminCommands.ToggleInvisible(player)
    if not isAdmin(player) then return end
    local data = getPlayerData(player)
    data.invisible = not data.invisible
    local char = getCharacter(player)
    if char then
        for _, part in pairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.Transparency = data.invisible and 1 or 0
            end
        end
    end
    return data.invisible
end

function AdminCommands.ToggleKillAura(player)
    if not isAdmin(player) then return end
    local data = getPlayerData(player)
    data.killAura = not data.killAura
    return data.killAura
end

-- ============ COMBAT SYSTEM ============
local CombatSystem = {}

function CombatSystem.TriggerCombat(player, combatType, target)
    if not isAdmin(player) then return end
    local root = getRootPart(player)
    if not root then return end
    
    if combatType == "KillAura" then
        local data = getPlayerData(player)
        local range = data.auraRange or 20
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= player then
                local targetRoot = getRootPart(plr)
                if targetRoot and (targetRoot.Position - root.Position).Magnitude <= range then
                    local humanoid = getHumanoid(plr)
                    if humanoid then humanoid.Health = 0 end
                end
            end
        end
    elseif combatType == "DivineLightning" then
        local lightning = Instance.new("Part")
        lightning.Size = Vector3.new(1, 50, 1)
        lightning.Position = root.Position + Vector3.new(0, 25, 0)
        lightning.Material = Enum.Material.Neon
        lightning.Color = Color3.fromRGB(255, 255, 0)
        lightning.Anchored = true
        lightning.CanCollide = false
        lightning.Parent = workspace
        Debris:AddItem(lightning, 2)
        
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= player then
                local targetRoot = getRootPart(plr)
                if targetRoot and (targetRoot.Position - root.Position).Magnitude <= 30 then
                    local humanoid = getHumanoid(plr)
                    if humanoid then humanoid.Health = humanoid.Health - 50 end
                end
            end
        end
    elseif combatType == "MeteorStrike" then
        local meteor = Instance.new("Part")
        meteor.Size = Vector3.new(10, 10, 10)
        meteor.Shape = Enum.PartType.Ball
        meteor.Material = Enum.Material.Neon
        meteor.Color = Color3.fromRGB(255, 100, 0)
        meteor.Position = root.Position + Vector3.new(0, 100, 0)
        meteor.Anchored = false
        meteor.CanCollide = false
        meteor.Parent = workspace
        
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(4000, 4000, 4000)
        bodyVelocity.Velocity = Vector3.new(0, -200, 0)
        bodyVelocity.Parent = meteor
        
        task.wait(1)
        if meteor and meteor.Parent then meteor:Destroy() end
        
        local explosion = Instance.new("Explosion")
        explosion.Position = root.Position + Vector3.new(0, 5, 0)
        explosion.BlastRadius = 30
        explosion.BlastPressure = 100000
        explosion.Parent = workspace
        
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= player then
                local targetRoot = getRootPart(plr)
                if targetRoot and (targetRoot.Position - root.Position).Magnitude <= 30 then
                    local humanoid = getHumanoid(plr)
                    if humanoid then humanoid.Health = humanoid.Health - 80 end
                end
            end
        end
    elseif combatType == "SolarBeam" then
        local beam = Instance.new("Part")
        beam.Size = Vector3.new(5, 100, 5)
        beam.Position = root.Position + Vector3.new(0, 50, 0)
        beam.Material = Enum.Material.Neon
        beam.Color = Color3.fromRGB(255, 255, 255)
        beam.Anchored = true
        beam.CanCollide = false
        beam.Parent = workspace
        Debris:AddItem(beam, 2)
        
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= player then
                local targetRoot = getRootPart(plr)
                if targetRoot then
                    local distance = (Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z) - 
                                    Vector3.new(root.Position.X, root.Position.Y, root.Position.Z)).Magnitude
                    if distance <= 20 then
                        local humanoid = getHumanoid(plr)
                        if humanoid then humanoid.Health = humanoid.Health - 100 end
                    end
                end
            end
        end
    end
    
    remoteEvents.TriggerCombat:FireAllClients(player, combatType, root.Position)
end

