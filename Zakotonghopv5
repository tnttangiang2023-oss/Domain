    local Status = Instance.new("TextLabel")
    Status.Size = UDim2.new(1, -4, 0, 38)
    Status.BackgroundTransparency = 1
    Status.Text = "Trạng thái: Chưa chọn người chơi"
    Status.TextColor3 = Color3.fromRGB(180, 180, 180)
    Status.TextSize = 11
    Status.Font = Enum.Font.Gotham
    Status.Parent = Content

    local function FindPlayer(displayName)
        local search = string.lower(displayName)
        for _, player in ipairs(Players:GetPlayers()) do
            if string.lower(player.DisplayName) == search then return player end
        end
        return nil
    end

    CopyAvatar.MouseButton1Click:Connect(function()
        local target = FindPlayer(Input.Text)
        if not target then Status.Text = "❌ Không tìm thấy DisplayName." return end
        local character = LocalPlayer.Character
        if not character then Status.Text = "❌ Nhân vật chưa sẵn sàng." return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then Status.Text = "❌ Không tìm thấy Humanoid." return end
        
        local success, description = pcall(function()
            return Players:GetHumanoidDescriptionFromUserId(target.UserId)
        end)
        if not success or not description then Status.Text = "❌ Không lấy được avatar." return end
        
        local applied = pcall(function() humanoid:ApplyDescription(description) end)
        if applied then Status.Text = "✅ Đã copy avatar của @" .. target.DisplayName
        else Status.Text = "❌ Lỗi khi áp dụng avatar." end
    end)
end

