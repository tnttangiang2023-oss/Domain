local function CopyCode(code)
    if setclipboard then pcall(function() setclipboard(code) end)
    elseif toclipboard then pcall(function() toclipboard(code) end) end
end

local function ExecuteCode(code)
    pcall(function()
        local fn = loadstring(code)
        if fn then fn() end
    end)
end

