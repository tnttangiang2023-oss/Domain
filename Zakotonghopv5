-- Fix Lag Implementation (Giảm lag, tăng FPS, xóa hiệu ứng toàn diện)
local function ShowFixLag()
    ClearContent()

    local Info = Instance.new("TextLabel")
    Info.Size = UDim2.new(1, -4, 0, 45)
    Info.BackgroundTransparency = 1
    Info.Text = "⚡ Tối ưu hóa FPS & Giảm Lag tối đa cho Mobile/PC"
    Info.TextColor3 = Color3.fromRGB(0, 255, 120)
    Info.TextSize = 12
    Info.Font = Enum.Font.GothamBold
    Info.TextWrapped = true
    Info.Parent = Content

    local FixBtn = Instance.new("TextButton")
    FixBtn.Size = UDim2.new(1, -4, 0, 45)
    FixBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    FixBtn.Text = "🚀 KÍCH HOẠT TỐI ƯU (FIX LAG)"
    FixBtn.TextColor3 = Color3.new(1, 1, 1)
    FixBtn.TextSize = 12
    FixBtn.Font = Enum.Font.GothamBold
    FixBtn.Parent = Content

    local FixCorner = Instance.new("UICorner")
    FixCorner.CornerRadius = UDim.new(0, 6)
    FixCorner.Parent = FixBtn

    local Status = Instance.new("TextLabel")
    Status.Size = UDim2.new(1, -4, 0, 35)
    Status.BackgroundTransparency = 1
    Status.Text = "Trạng thái: Chưa bật"
    Status.TextColor3 = Color3.fromRGB(180, 180, 180)
    Status.TextSize = 11
    Status.Font = Enum.Font.Gotham
    Status.Parent = Content

    FixBtn.MouseButton1Click:Connect(function()
        pcall(function()
            -- Xóa hiệu ứng ánh sáng nặng
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA("PostEffect") or v:IsA("Sky") or v:IsA("Atmosphere") or v:IsA("BloomEffect") or v:IsA("BlurEffect") then
                    v:Destroy()
                end
            end
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9

            -- Giảm chất lượng Render vật thể
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            workspace.CurrentCamera.FieldOfView = 70

            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") then
                    obj.Material = Enum.Material.SmoothPlastic
                    obj.Reflectance = 0
                elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                    obj.Enabled = false
                end
            end
            
            if Terrain then
                Terrain.WaterWaveSize = 0
                Terrain.WaterWaveSpeed = 0
                Terrain.WaterTransparency = 0
                Terrain.WaterReflectance = 0
            end

            Status.Text = "✅ Đã tối ưu hóa, xóa hiệu ứng & tăng FPS thành công!"
            Status.TextColor3 = Color3.fromRGB(0, 255, 120)
        end)
    end)
end

